        private bool _Thuchien = false;
        [XafDisplayName("Thực hiện"), Browsable(false)]
        public bool Thuchien
        {
            get { return _Thuchien; }
            set
            {
                bool isModified = SetPropertyValue<bool>(nameof(Thuchien), ref _Thuchien, value);
                if (isModified && !IsLoading && !IsSaving && !IsDeleted)
                    RefreshMau();
            }
        }

        private MauVanban _Mau;
        [Association]
        [XafDisplayName("Mẫu đề xuất")]
        [RuleRequiredField("Yeucau mauphieu", DefaultContexts.Save, "Phải có mẫu đề xuất")]
        [DataSourceProperty(nameof(DSMau))]
        [ImmediatePostData]

        public MauVanban Mau
        {
            get { return _Mau; }
            set
            {
                bool IsModified = SetPropertyValue<MauVanban>(nameof(Mau), ref _Mau, value);
                if (IsModified && !IsLoading && !IsSaving && !IsDeleted && value != null)
                {
                    IsCoso = value.ApdungCS;
                    ChonChuthe = Mau.ChonNV;
                    if (string.IsNullOrEmpty(TenDexuat) && Nhanvien != null && value != null)
                    {
                        TenDexuat = Mau.Kyhieu + "-";
                    }
                }
            }
        }

        private XPCollection<MauVanban> ListMau;
        public XPCollection<MauVanban> DSMau
        {
            get
            {
                if (ListMau == null)
                {
                    ListMau = new XPCollection<MauVanban>(Session);
                    RefreshMau();
                }
                return ListMau;
            }
        }

        private void RefreshMau()
        {
            ListMau = new XPCollection<MauVanban>(Session)
            {
                Criteria = CriteriaOperator.Parse("Oid=?", 0)
            };
            if (Thuchien)
            {
                Nhansu nv = TCom.GetCurrentNhanvien();
                if (nv != null && nv.Donvi != null)
                {
                    XPCollection<MauVanban> Mauchon = new(Session)
                    {
                        Criteria = CriteriaOperator.Parse("Thuchien=? && Huy=?", true, false)
                    };
                    foreach (MauVanban p in Mauchon)
                    {
                        ListMau.Add(p);
                    }
                }
            }
            else
            {
                Nhansu nv = TCom.GetCurrentNhanvien();
                if (nv != null && nv.Donvi != null)
                {
                    XPCollection<MauBP> Mauchon = new(Session)
                    {
                        Criteria = CriteriaOperator.Parse("Donvi=? && Mau.Huy=?", Session.GetObjectByKey<Bophan>(nv.Donvi.Oid), false)
                    };
                    foreach (MauBP p in Mauchon)
                    {
                        ListMau.Add(p.Mau);
                    }
                }
            }

        }

