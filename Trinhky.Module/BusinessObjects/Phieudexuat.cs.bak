        private TCom.EStatusXL _TrangthaiXL;
        [XafDisplayName("Xử lý")]
        public TCom.EStatusXL TrangthaiXL
        {
            get { return _TrangthaiXL; }
            set 
            { 
                bool isModified = SetPropertyValue<TCom.EStatusXL>(nameof(TrangthaiXL), ref _TrangthaiXL, value); 
                if(isModified && !IsLoading)
                {
                    if (value == TCom.EStatusXL.xlxong)
                    {
                        Daxong = true;
                        Ngayxong = TCom.GetServerDateTime();
                    }
                    else
                    {
                        Daxong = false;
                        Ngayxong = DateTime.MinValue;
                    }
                }
            }
        }

