        private XPCollection<Nhansu> NhanvienPhong;
        public XPCollection<Nhansu> DSNVs
        {
            get
            {
                if (NhanvienPhong == null)
                {
                    NhanvienPhong = new XPCollection<Nhansu>(Session);
                    RefreshNVs();
                }
                return NhanvienPhong;
            }
        }

        private void RefreshNVs()
        {
            NhanvienPhong = new XPCollection<Nhansu>(Session)
            {
                Criteria = CriteriaOperator.Parse("Oid=?", 0)
            };
            if (NguoiXuly != null && NguoiXuly.Donvi != null)
            {
                XPCollection<Nhansu> dss = new(Session)
                {
                    Criteria = CriteriaOperator.Parse("Donvi=?", NguoiXuly.Donvi)
                };
                foreach (Nhansu p in dss)
                {
                    NhanvienPhong.Add(p);
                }
                //Bo phan thuc hien
                XPCollection<Bophan> listbp = new(Session)
                {
                    Criteria = CriteriaOperator.Parse("Thuchien=?", true)
                };
                foreach (Bophan b in listbp)
                {
                    foreach (Nhansu nv in b.Nhansus)
                    {
                        NhanvienPhong.Add(nv);
                    }
                }
            }
        }

        [XafDisplayName("Thông tin phiếu"), VisibleInListView(false)]
        public string ThongtinPhieu
        {
            get
            {
                string tt = "Số: " + Oid.ToString();
                if (Ngay != DateTime.MinValue)
                    tt += ", Ngày: " + Ngay.ToString("dd/MM/yyyy HH:mm");
                if (Nhanvien != null)
                    tt += ", Người lập: " + Nhanvien.HoTen;
                if (Nhanvien.Donvi != null)
                    tt += ", Bộ phận: " + Nhanvien.Donvi.Name;
                if (Nhanvien.CS != null)
                    tt += ", Cơ sở: " + Nhanvien.CS.TenCoso;
                return tt;
            }
        }

