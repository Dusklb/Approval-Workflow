    void GotoDetailsViewClick(QTDuyet buocduyet)
    {
        string msg = ((buocduyet.Boqua=="X") ? "Chắc chắn DUYỆT bước này?" : "Chắc chắn BỎ QUA bước này?");
        NonPersistentObjectSpace nonPersistentObjectSpace =
            (NonPersistentObjectSpace)myApp.CreateObjectSpace(typeof(ConfirmationWindowParameters));
        ConfirmationWindowParameters parameters = new()
            {
                ConfirmationMessage = msg
            };
        DetailView confirmationDetailView = myApp.CreateDetailView(nonPersistentObjectSpace, parameters);
        confirmationDetailView.Caption = "Xác nhận";
        myApp.ShowViewStrategy.ShowViewInPopupWindow(confirmationDetailView, ()=>Xulybuoc(buocduyet));

    }
    void Xulybuoc(QTDuyet buocduyet)
    {
        if (buocduyet.SoTT == 1)
        {
            TCom.CustomError("Bạn không thể bỏ qua chính mình");
            return;
        }
        Session session = ((XPObjectSpace)myObjectSpace).Session;
        if (buocduyet.Boqua == "X")
        {
            string sql = "Update DuyetDexuat set Boqua=0 where Oid="+buocduyet.Id;
            session.ExecuteNonQuery(sql);
        }
        else
        {
            string sql = "Update DuyetDexuat set Boqua=1, Trangthai=0 where Oid="+buocduyet.Id;
            session.ExecuteNonQuery(sql);
        }
        var list = new List<QTDuyet>(ListDuyet.Length);
        for (int i = 0; i < ListDuyet.Length; i++)
        {
            if (ListDuyet[i].Id == buocduyet.Id)
            {
                if (buocduyet.Boqua == "X")
                {
                    ListDuyet[i].Boqua = "";
                    ListDuyet[i].Ketluan = "Chờ xử lý";
                }
                else
                {
                    ListDuyet[i].Boqua = "X";
                    ListDuyet[i].Ketluan = "Bỏ qua bước này";
                }
            }
            list.Add(ListDuyet[i]);
        }
        ListDuyet = list.ToArray<QTDuyet>();
        InvokeAsync(() => StateHasChanged());
    }

    void OnBuocduyetItemDeleting(GridDataItemDeletingEventArgs e)
    {
        // Xoa chia se.
        var dataItem = e.DataItem as QTDuyet;
        if (dataItem != null)
        {
            IObjectSpace objectSpace = objectSpaceFactory.CreateObjectSpace(typeof(DuyetDexuat));
            DuyetDexuat duyetdx = objectSpace.FindObject<DuyetDexuat>(CriteriaOperator.Parse("Oid=?", dataItem.Id));
            if (duyetdx != null)
            {
                if (duyetdx.Phieu != null)
                {
                    RichEditDocumentServer KyProcessor = new()
                        {
                            RtfText = duyetdx.Phieu.Kyduyet
                        };
                    string ma = duyetdx.Maduyet;
                    string machuky = duyetdx.MaChuky;
                    if (!string.IsNullOrEmpty(ma))
                        KyProcessor.Document.ReplaceAll(ma, "", DevExpress.XtraRichEdit.API.Native.SearchOptions.None);
                    if (!string.IsNullOrEmpty(machuky))
                        KyProcessor.Document.ReplaceAll(machuky, "", DevExpress.XtraRichEdit.API.Native.SearchOptions.None);
                    duyetdx.Phieu.Kyduyet = KyProcessor.RtfText;
                    duyetdx.Phieu.Save();
                    objectSpace.CommitChanges();
                }
                duyetdx.Delete();
                objectSpace.CommitChanges();
                var list = new List<QTDuyet>(ListDuyet.Length);
                for (int i = 0; i < ListDuyet.Length; i++)
                {
                    if (ListDuyet[i].Id != dataItem.Id)
                    {
                        list.Add(ListDuyet[i]);
                    }
                }
                ListDuyet = list.ToArray<QTDuyet>();
                InvokeAsync(() => StateHasChanged());
            }
            //string sql = "Delete from DuyetDexuat where Oid=" + dataItem.Id;
            //Session session = ((XPObjectSpace)objectSpace).Session;
            //session.ExecuteNonQuery(sql);

        }

    }
